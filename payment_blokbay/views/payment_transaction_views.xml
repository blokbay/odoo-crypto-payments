<odoo>
    <record id="payment_transaction_form" model="ir.ui.view">
        <field name="name">Blokbay Transaction Form</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <field name="provider_reference" position="after">
                <field name="blokbay_network" invisible="provider_code != 'blokbay' or not blokbay_network"/>
                <field name="blokbay_coin" invisible="provider_code != 'blokbay' or not blokbay_coin"/>
                <field name="blokbay_tx_hash" invisible="provider_code != 'blokbay' or not blokbay_tx_hash"/>
            </field>
        </field>
    </record>
</odoo>
