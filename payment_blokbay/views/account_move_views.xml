<odoo>
    <record id="view_move_form_blokbay" model="ir.ui.view">
        <field name="name">account.move.form.blokbay</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="after">
                <button name="action_blokbay_invoice" type="object" string="Pay with Blokbay" class="oe_highlight"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state in ('paid', 'in_payment', 'reversed') or blokbay_invoice_status == 'open'"
                        help="Create a payment link in USDC or USDT for this invoice. The invoice is marked paid when the client pays."/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Blokbay" name="blokbay" invisible="not blokbay_invoice_status">
                    <group>
                        <field name="blokbay_invoice_status"/>
                        <field name="blokbay_payment_url" widget="url"/>
                        <field name="blokbay_invoice_id" groups="base.group_no_one"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
