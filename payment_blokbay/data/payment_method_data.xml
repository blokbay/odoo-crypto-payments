<!-- noupdate: the name is set only at the first install; a name changed by the merchant (or the 1.0/1.1 name) is kept on update. -->
<odoo noupdate="1">
    <record id="payment_method_blokbay_crypto" model="payment.method">
        <field name="name">Crypto (USDT, USDC, ETH, BTC, SOL)</field>
        <field name="code">blokbay_crypto</field>
        <field name="sequence">1000</field>
        <field name="image" type="base64" file="payment_blokbay/static/src/img/crypto.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="supported_currency_ids" eval="[Command.set([ref('base.USD'), ref('base.EUR'), ref('base.GBP'), ref('base.CHF'), ref('base.JPY'), ref('base.CAD'), ref('base.AUD'), ref('base.SGD'), ref('base.HKD'), ref('base.AED')])]"/>
    </record>
</odoo>
