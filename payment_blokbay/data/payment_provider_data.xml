<odoo noupdate="1">
    <record id="payment_provider_blokbay" model="payment.provider">
        <field name="name">Blokbay</field>
        <field name="code">blokbay</field>
        <field name="image_128" type="base64" file="payment_blokbay/static/description/icon.png"/>
        <field name="module_id" ref="base.module_payment_blokbay"/>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="allow_tokenization">False</field>
        <field name="payment_method_ids" eval="[Command.set([ref('payment_method_blokbay_crypto')])]"/>
        <field name="pending_msg" type="html"><p>Your crypto payment is being confirmed on the blockchain. Your order will be confirmed automatically.</p></field>
    </record>
</odoo>
